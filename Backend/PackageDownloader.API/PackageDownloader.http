@PackageDownloader_HostAddress = http://localhost:5093
@NpmJSApiHost = https://www.npmjs.com
@NugetApiHost = https://azuresearch-usnc.nuget.org

@NPMPackageName = lodash
@NugetPackageName = Dapper
@AIQuestion = 2D графика
@GitHubRepository = sharkdp/hyperfine

# Поисковые подcказки яндекса

GET https://suggest.yandex.ru/suggest-ff.cgi?part=Ктоя
Accept: application/json

###


# Рекомендации по пакетам через AI

GET {{PackageDownloader_HostAddress}}/api/Recommendations/GetRecommendations?packageType=Nuget&userPrompt={{AIQuestion}}&langCode=en
Accept: application/json
###

# Найти пакеты на сайте nuget.org через собственное API
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetSearchResults?packageType=Nuget&namePart={{NugetPackageName}}
Accept: application/json

###

# Найти пакеты на сайте npmjs.com через собственное API
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetSearchResults?packageType=NPM&namePart={{NPMPackageName}}
Accept: application/json

###

# Полуть автокомплит на сайте npmjs.com через собственное API
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetSearchSuggestions?packageType=Npm&namePart={{NPMPackageName}}
Accept: application/json

###

# Получить подсказки через API npmjs.com
GET {{NpmJSApiHost}}/search/suggestions?q={{NPMPackageName}}
Accept: application/json

###

# Найти пакеты через API npmjs.com
GET {{NpmJSApiHost}}/search?q={{NPMPackageName}}
Accept: application/json
X-Spiferack: 1

### 


# Подробная информация о пакете NPM
GET {{NpmJSApiHost}}/package/{{NPMPackageName}}
Accept: application/json
X-Spiferack: 1
###


# Найти пакеты через API Nuget
GET {{NugetApiHost}}/query?q={{NugetPackageName}}
Accept: application/json

###

# Полуить подсказки поиска через API Nuget
GET {{NugetApiHost}}/autocomplete?q={{NugetPackageName}}
Accept: application/json

###
@ExtensionName = vscode-typescript-next
@Publisher = ms-vscode
@Version = 5.9.20250301

# Скачать vsix расширение для Vs Code
GET https://marketplace.visualstudio.com/_apis/public/gallery/publishers/{{Publisher}}/vsextensions/{{ExtensionName}}/{{Version}}/vspackage


###

# ---------------------------------------------------------------------------
# GitHub: релизы репозитория (ассеты) + всегда доступная версия latest.source
# ---------------------------------------------------------------------------

# Найти репозитории на GitHub
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetSearchResults?packageType=GitHub&namePart=hyperfine
Accept: application/json

###

# Подсказки по именам репозиториев
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetSearchSuggestions?packageType=GitHub&namePart=hyperfine
Accept: application/json

###

# Версии репозитория: первым всегда идёт latest.source (главная ветка), далее теги релизов
GET {{PackageDownloader_HostAddress}}/api/PackageInfo/GetPackageVersions?packageType=GitHub&packageName={{GitHubRepository}}&maxVersionsCount=10
Accept: application/json

###

# Типы артефактов выбранной версии (ассеты релиза + source, и all при нескольких ассетах)
GET {{PackageDownloader_HostAddress}}/api/GitHub/packages/artifacts?packageId={{GitHubRepository}}&version=v1.20.0
Accept: application/json

###

# Подробная информация о репозитории
GET {{PackageDownloader_HostAddress}}/api/GitHub/packages/details?packageId={{GitHubRepository}}
Accept: application/json

###

# Скачать конкретный ассет конкретного релиза
POST {{PackageDownloader_HostAddress}}/api/Packages/PreparePackagesDownloadLink
Content-Type: application/json

{
  "packageType": "GitHub",
  "packagesDetails": [
    {
      "packageID": "{{GitHubRepository}}",
      "packageVersion": "v1.20.0",
      "artifactType": "hyperfine_1.20.0_arm64.deb"
    }
  ]
}

###

# Скачать все ассеты последнего релиза (artifactType не указан == all)
POST {{PackageDownloader_HostAddress}}/api/Packages/PreparePackagesDownloadLink
Content-Type: application/json

{
  "packageType": "GitHub",
  "packagesDetails": [
    {
      "packageID": "{{GitHubRepository}}"
    }
  ]
}

###

# Скачать главную ветку репозитория архивом (версия latest.source)
POST {{PackageDownloader_HostAddress}}/api/Packages/PreparePackagesDownloadLink
Content-Type: application/json

{
  "packageType": "GitHub",
  "packagesDetails": [
    {
      "packageID": "{{GitHubRepository}}",
      "packageVersion": "latest.source"
    }
  ]
}

###

# Скачать исходники конкретного тега (суффикс .source у любой версии)
POST {{PackageDownloader_HostAddress}}/api/Packages/PreparePackagesDownloadLink
Content-Type: application/json

{
  "packageType": "GitHub",
  "packagesDetails": [
    {
      "packageID": "{{GitHubRepository}}",
      "packageVersion": "v1.20.0.source"
    }
  ]
}
