TARGET_URL=http://127.0.0.1:5094
BUILD_LABEL=optimized
RUN_ID=
PROFILE=load
RATE=2
DURATION=2m
PRE_ALLOCATED_VUS=4
MAX_VUS=20
MAX_VERSIONS=40
INCLUDE_DOCKER=false
K6_BIN=k6
K6_SCRIPT=provider-load.js
K6_WEB_DASHBOARD=true
K6_HTML_REPORT_FILE=k6-report.html
WARMUP_ENABLED=true
WARMUP_PROFILE=smoke
START_BACKEND=true
BUILD_BACKEND=true
BACKEND_PROJECT=../../../PackageDownloader.API/PackageDownloader.API.csproj
BACKEND_DLL=../../../PackageDownloader.API/bin/Release/net10.0/PackageDownloader.API.dll
BACKEND_CONFIGURATION=Release
BACKEND_PID=0
STARTUP_TIMEOUT_SECONDS=60
DOTNET_BIN=dotnet
COUNTERS_LAUNCHER=dotnet
COUNTERS_TOOL=dnx
COUNTERS_PACKAGE=dotnet-counters
COUNTERS_AUTO_CONFIRM=true
COUNTERS=System.Runtime
SAMPLE_INTERVAL_SECONDS=1
COUNTER_START_TIMEOUT_SECONDS=60
COLLECTOR_START_DELAY_SECONDS=2
NODE_BIN=node
RESOURCE_SUMMARIZER=summarize-resources.mjs
RESULT_ROOT=results
K6_SUMMARY_FILE=k6-summary.json
K6_LOG_FILE=k6.log
WARMUP_SUMMARY_FILE=warmup-summary.json
WARMUP_LOG_FILE=warmup.log
COUNTERS_FILE=runtime-counters.csv
PROCESS_SAMPLES_FILE=process-samples.csv
RESOURCE_SUMMARY_FILE=resource-summary.json
BACKEND_LOG_FILE=backend.log
